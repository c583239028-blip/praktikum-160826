{
  "name": "client",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "sync-env": "node -e \"const fs=require('fs'),path=require('path');const root=path.resolve(__dirname,'../..'),dev=path.join(root,'.env.development'),prod=path.join(root,'.env'),dest=path.resolve(__dirname,'.env');if(fs.existsSync(dev)){fs.copyFileSync(dev,dest);console.log('✓ .env synced from .env.development');}else if(fs.existsSync(prod)){fs.copyFileSync(prod,dest);console.log('✓ .env synced from .env');}\"",
    "start": "npm run sync-env && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npm run sync-env && expo run:android",
    "ios": "npm run sync-env && expo run:ios",
    "web": "npm run sync-env && expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "dependencies": {

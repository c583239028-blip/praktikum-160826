# @worldplay/media-server — staging env example
#
# Documentation only. Infisical (env=dev/staging) is the source of truth for
# real values — do NOT commit real secrets here. Copy to `.env` and fill in,
# or let Infisical inject these at runtime.

# --- Core ---
# HTTP + Socket.IO port. Default 8000.
MEDIA_PORT=8000

# Postgres connection. Read directly by Prisma to drive the catch-up buffer.
DATABASE_URL=REPLACE_ME

# --- Auth ---
# JWT secret used to validate socket connections (socketAuth.js). Must match
# the app-server's JWT_SECRET.
JWT_SECRET=REPLACE_ME

# Shared secret for the internal app-server <-> media-server channel
# (internalAuth.js). Must match the app-server's INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=REPLACE_ME

# --- App-server target (SCRUM-346) ---
# Where the media-server makes internal calls to the app-server. Inside the
# shared docker-compose network the default hostname resolves; override when
# media runs on its own droplet. Default: http://app-server:8080
APP_SERVER_URL=http://app-server:8080

# --- WebRTC / mediasoup ---
# Public IP the server announces to clients for ICE. On staging this must be
# the droplet's reachable public IP (127.0.0.1 only works locally).
ANNOUNCED_IP=REPLACE_ME

# UDP port range mediasoup uses for WebRTC media. Must be open in the firewall.
RTC_MIN_PORT=10000
RTC_MAX_PORT=10010

# --- Optional / dev flags ---
# Skip reconciling in-flight streams on boot. Leave unset in normal operation.
# SKIP_STREAM_RECONCILE=true

{
  "name": "@worldplay/server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "infisical run --project-config-dir . -- node src/index.js",
    "start:cloud": "node src/index.js",
    "dev": "infisical run -- nodemon src/index.js",
    "dev:local": "nodemon src/index.js",
    "test": "vitest run",
    "db:push": "infisical run -- npx prisma db push",
    "db:migrate": "infisical run -- node scripts/migrate-local.mjs",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@worldplay/shared": "file:../shared",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "prisma": "5.22.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/socket.io": "^3.0.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
